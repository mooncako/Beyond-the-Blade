        #endif
        #ifdef VARYINGS_DS_NEED_TEXCOORD3
            TESSELLATION_INTERPOLATE_BARY(texCoord3, baryCoords);
        #endif
        #ifdef VARYINGS_DS_NEED_COLOR
            TESSELLATION_INTERPOLATE_BARY(color, baryCoords);
