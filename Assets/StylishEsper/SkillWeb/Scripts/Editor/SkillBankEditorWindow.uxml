<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/StylishEsper/SkillWeb/Scripts/Editor/SkillBankEditorWindow.uss?fileID=7433441132597879392&amp;guid=c0eb3b9881e6c9947a729a46756d1c14&amp;type=3#SkillBankEditorWindow" />
    <uie:Toolbar style="justify-content: flex-end;">
        <ui:DropdownField name="TagFilter" />
        <ui:DropdownField name="SizeFilter" />
        <uie:ToolbarSearchField name="SearchField" style="width: 30%;" />
    </uie:Toolbar>
    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 1;">
            <ui:ScrollView horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
                <ui:VisualElement name="SkillScrollContent" style="flex-grow: 1; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
                    <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" class="skillRoot">
                        <ui:VisualElement class="skillContent">
                            <ui:VisualElement class="skillIcon" />
                            <ui:Label tabindex="-1" text="Skill Name" parse-escape-sequences="true" display-tooltip-when-elided="true" class="skillLabel" style="flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; font-size: 16px;" />
                            <ui:Label tabindex="-1" text="ID: 0" parse-escape-sequences="true" display-tooltip-when-elided="true" class="skillLabel" style="flex-shrink: 1; font-size: 12px; -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; padding-top: 2px; padding-right: 4px; padding-bottom: 0; padding-left: 4px; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35);">
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="CreateButton" tooltip="Create New Skill" style="height: 24px; width: 24px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;">
                    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/StylishEsper/SkillWeb/Editor/Icons/icon_plus.png?fileID=2800000&amp;guid=192a6f85e4a07824ab3493996477f027&amp;type=3#icon_plus&quot;); flex-shrink: 0;" />
                </ui:Button>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="DeleteButton" tooltip="Delete Skill" style="height: 24px; width: 24px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; background-color: rgb(181, 69, 69); display: flex; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;">
                    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/StylishEsper/SkillWeb/Editor/Icons/icon_delete.png?fileID=2800000&amp;guid=6183bb79ae14d7949b4e2ae8d55b8863&amp;type=3#icon_delete&quot;); flex-shrink: 0;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; height: 32px; flex-direction: row; align-items: center; justify-content: center; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-top-width: 1px; flex-shrink: 0;">
                <ui:VisualElement style="flex-grow: 1; position: absolute; width: 100%; height: 100%; align-items: flex-end; justify-content: center; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
                    <ui:Label tabindex="-1" text="0-0 of 0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SkillAmountLabel" style="display: flex; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="PreviousPageButton" class="paginationButton" style="background-image: url(&quot;project://database/Assets/StylishEsper/SkillWeb/Editor/Icons/left_icon.png?fileID=2800000&amp;guid=7cfbf676d9a06dc49baf34609e82b07a&amp;type=3#left_icon&quot;);" />
                <ui:Label tabindex="-1" text="1/1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PagesLabel" style="-unity-text-align: middle-center; font-size: 14px;" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="NextPageButton" class="paginationButton" style="background-image: url(&quot;project://database/Assets/StylishEsper/SkillWeb/Editor/Icons/right_icon.png?fileID=2800000&amp;guid=6a8490a5115c53046a77e4cb3bd3f512&amp;type=3#right_icon&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-right-width: 0; width: 35%; border-left-width: 1px;">
            <ui:ScrollView horizontal-scroller-visibility="Hidden" name="InspectorScroll" style="flex-grow: 1; display: flex;">
                <ui:Foldout text="General" name="GeneralFoldout" style="padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Name" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <ui:TextField picking-mode="Ignore" name="NameField" style="flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Tag" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <ui:DropdownField name="TagField" style="flex-shrink: 1; flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Max Lvl" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <ui:IntegerField value="0" name="MaxLevelField" style="flex-grow: 1; flex-shrink: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Lvl Requirement" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <ui:IntegerField value="0" name="LevelRequirementField" style="flex-grow: 1; flex-shrink: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-bottom: 4px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                            <ui:Label tabindex="-1" text="Locked Icon" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ObjectField type="UnityEngine.Sprite, UnityEngine.CoreModule" name="LockedIconField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
                            <ui:Label tabindex="-1" text="Color Tint" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ColorField value="RGBA(0.000, 1.000, 1.000, 1.000)" name="LockedColorField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-bottom: 4px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                            <ui:Label tabindex="-1" text="Unlocked Icon" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ObjectField type="UnityEngine.Sprite, UnityEngine.CoreModule" name="UnlockedIconField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
                            <ui:Label tabindex="-1" text="Color Tint" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ColorField value="RGBA(0.000, 1.000, 1.000, 1.000)" name="UnlockedColorField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-bottom: 4px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                            <ui:Label tabindex="-1" text="Obtained Icon" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ObjectField type="UnityEngine.Sprite, UnityEngine.CoreModule" name="ObtainedIconField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
                            <ui:Label tabindex="-1" text="Color Tint" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ColorField value="RGBA(0.000, 1.000, 1.000, 1.000)" name="ObtainedColorField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; border-left-color: rgb(35, 35, 35); border-right-color: rgb(35, 35, 35); border-top-color: rgb(35, 35, 35); border-bottom-color: rgb(35, 35, 35); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-bottom: 4px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                            <ui:Label tabindex="-1" text="Maxed Icon" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ObjectField type="UnityEngine.Sprite, UnityEngine.CoreModule" name="MaxedIconField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
                            <ui:Label tabindex="-1" text="Color Tint" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                            <uie:ColorField value="RGBA(0.000, 1.000, 1.000, 1.000)" name="MaxedColorField" style="flex-grow: 1; flex-shrink: 1;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Size" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <ui:EnumField type="Esper.SkillWeb.Skill+Size, SkillWeb" name="SizeField" style="flex-grow: 1; flex-shrink: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
                        <ui:Label tabindex="-1" text="Demo Clip" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; flex-shrink: 1;" />
                        <uie:ObjectField type="UnityEngine.Video.VideoClip, UnityEngine.VideoModule" name="DemoClipField" style="flex-shrink: 1; flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:Foldout>
                <ui:Foldout text="Dataset" name="DatasetFoldout" style="padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
