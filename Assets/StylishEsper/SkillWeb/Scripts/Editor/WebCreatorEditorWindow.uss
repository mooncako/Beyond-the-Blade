.unity-integer-field__label {
    margin-right: -16px;
}

.maxLvlLabel {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 2px;
    padding-right: 2px;
